<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.omrscanner.ui.CountdownTimerOverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      Panel trên gọn tối đa (khung đỏ càng to, camera cầm càng thấp):
      ảnh MẪU GIẤY đang chọn (có viền) + chọn mẫu xếp NGANG.
      Overlay đọc chiều cao panel này (topInset) nên khung đỏ KHÔNG bị đè lên.
    -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@color/scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingTop="2dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgTemplate"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_template_thumb"
            android:contentDescription="@string/template_preview"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:src="@drawable/template_mau12" />

        <RadioGroup
            android:id="@+id/radioSheetType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioMau1011"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/radio_mau_1011"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <RadioButton
                android:id="@+id/radioMau12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:button="@null"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/radio_mau_12"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </RadioGroup>
    </LinearLayout>

    <!-- Thanh dưới gọn: trạng thái + tự chụp chung 1 hàng, nút thấp 34dp -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/scrim"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/status_starting"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <Switch
                android:id="@+id/switchAutoCapture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:checked="true"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/btn_auto_capture_3s"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTorch"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:alpha="0.75"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_torch"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnShutter"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.4"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_shutter"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
